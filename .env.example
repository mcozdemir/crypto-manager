# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun. .env Git'e gönderilmez.
# Turso panelinden: veritabanı adresi (libsql://...) ve erişim anahtarı (token)
APP_TURSO_TECH_DB_URL=
APP_TURSO_TECH_TOKEN=

# İsteğe bağlı: ücretsiz CoinGecko Demo API anahtarı (temel analiz verisi için)
APP_COINGECKO_API_KEY=
